generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  teacher
  student

  @@map("user_role")
}

enum ContentLevel {
  beginner
  intermediate
  advanced

  @@map("content_level")
}

enum ContentType {
  grammar
  story
  vocab
  pronunciation
  quiz

  @@map("content_type")
}

enum PronunciationScore {
  exact
  close
  mismatch

  @@map("pronunciation_score")
}

enum PronunciationTargetType {
  word
  phrase
  sentence

  @@map("pronunciation_target_type")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")

  grammarLessons         GrammarLesson[]
  stories                Story[]
  vocabLists             VocabList[]
  vocabItems             VocabItem[]
  pronunciationExercises PronunciationExercise[]
  quizzes                Quiz[]
  quizAttempts           QuizAttempt[]
  progressCompletions    ProgressCompletion[]
  pronunciationAttempts  PronunciationAttempt[]
  taughtClassrooms       Classroom[]
  joinedClassrooms       ClassroomStudent[]

  @@map("users")
}

model GrammarLesson {
  id        String       @id @default(uuid())
  title     String
  content   String
  level     ContentLevel
  teacherId String       @map("teacher_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  teacher              User               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  storyRefs            StoryGrammarRef[]
  tags                 GrammarLessonTag[]
  classroomAssignments ClassroomGrammar[]

  @@index([level])
  @@map("grammar_lessons")
}

model Story {
  id        String       @id @default(uuid())
  title     String
  content   String
  summary   String
  level     ContentLevel
  teacherId String       @map("teacher_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  teacher              User                     @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  grammarRefs          StoryGrammarRef[]
  vocabRefs            StoryVocabRef[]
  tags                 StoryTag[]
  pronunciationLinks   PronunciationStoryLink[]
  classroomAssignments ClassroomStory[]

  @@index([level])
  @@map("stories")
}

model StoryGrammarRef {
  storyId   String @map("story_id")
  grammarId String @map("grammar_id")

  story   Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  grammar GrammarLesson @relation(fields: [grammarId], references: [id], onDelete: Restrict)

  @@id([storyId, grammarId])
  @@map("story_grammar_refs")
}

model VocabList {
  id          String       @id @default(uuid())
  name        String
  description String
  level       ContentLevel
  teacherId   String       @map("teacher_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  teacher              User                 @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  items                VocabItem[]
  classroomAssignments ClassroomVocabList[]

  @@index([level])
  @@map("vocab_lists")
}

model VocabItem {
  id         String       @id @default(uuid())
  word       String
  definition String
  example    String
  phonetic   String
  listId     String       @map("list_id")
  level      ContentLevel
  teacherId  String       @map("teacher_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  list               VocabList                @relation(fields: [listId], references: [id], onDelete: Cascade)
  teacher            User                     @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  storyRefs          StoryVocabRef[]
  pronunciationLinks PronunciationVocabLink[]

  @@index([listId])
  @@map("vocab_items")
}

model StoryVocabRef {
  storyId       String @map("story_id")
  vocabItemId   String @map("vocab_item_id")
  highlightText String @map("highlight_text")

  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  vocabItem VocabItem @relation(fields: [vocabItemId], references: [id], onDelete: Restrict)

  @@id([storyId, vocabItemId, highlightText])
  @@map("story_vocab_refs")
}

model PronunciationExercise {
  id           String                  @id @default(uuid())
  targetText   String                  @map("target_text")
  type         PronunciationTargetType
  level        ContentLevel
  instructions String
  teacherId    String                  @map("teacher_id")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  teacher              User                     @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  vocabLinks           PronunciationVocabLink[]
  storyLinks           PronunciationStoryLink[]
  attempts             PronunciationAttempt[]
  classroomAssignments ClassroomPronunciation[]

  @@map("pronunciation_exercises")
}

model PronunciationVocabLink {
  exerciseId  String @map("exercise_id")
  vocabItemId String @map("vocab_item_id")

  exercise  PronunciationExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  vocabItem VocabItem             @relation(fields: [vocabItemId], references: [id], onDelete: Restrict)

  @@id([exerciseId, vocabItemId])
  @@map("pronunciation_vocab_links")
}

model PronunciationStoryLink {
  exerciseId String @map("exercise_id")
  storyId    String @map("story_id")

  exercise PronunciationExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  story    Story                 @relation(fields: [storyId], references: [id], onDelete: Restrict)

  @@id([exerciseId, storyId])
  @@map("pronunciation_story_links")
}

model Quiz {
  id          String       @id @default(uuid())
  title       String
  description String
  level       ContentLevel
  teacherId   String       @map("teacher_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  teacher              User              @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  questions            QuizQuestion[]
  attempts             QuizAttempt[]
  contentLinks         QuizContentLink[]
  classroomAssignments ClassroomQuiz[]

  @@map("quizzes")
}

model QuizContentLink {
  quizId     String      @map("quiz_id")
  linkedType ContentType @map("linked_type")
  linkedId   String      @map("linked_id")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([quizId, linkedType, linkedId])
  @@map("quiz_content_links")
}

model QuizQuestion {
  id              String  @id @default(uuid())
  quizId          String  @map("quiz_id")
  text            String
  explanation     String
  correctOptionId String? @map("correct_option_id")

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@map("quiz_questions")
}

model QuizOption {
  id         String @id @default(uuid())
  questionId String @map("question_id")
  text       String

  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIn QuizAnswer[] @relation("SelectedOption")

  @@map("quiz_options")
}

model QuizAttempt {
  id               String   @id @default(uuid())
  quizId           String   @map("quiz_id")
  userId           String   @map("user_id")
  userNameSnapshot String   @map("user_name_snapshot")
  score            Int
  totalQuestions   Int      @map("total_questions")
  completedAt      DateTime @default(now()) @map("completed_at")

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([userId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  attemptId        String  @map("attempt_id")
  questionId       String  @map("question_id")
  selectedOptionId String  @map("selected_option_id")
  isCorrect        Boolean @map("is_correct")

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selected QuizOption   @relation("SelectedOption", fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@map("quiz_answers")
}

model ProgressCompletion {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  contentType ContentType @map("content_type")
  contentId   String      @map("content_id")
  completedAt DateTime    @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId], name: "userId_contentType_contentId")
  @@index([userId])
  @@map("progress_completions")
}

model PronunciationAttempt {
  id           String             @id @default(uuid())
  exerciseId   String             @map("exercise_id")
  userId       String             @map("user_id")
  expected     String
  transcript   String
  score        PronunciationScore
  matchPercent Decimal            @map("match_percent") @db.Decimal(5, 2)
  feedback     String
  timestamp    DateTime           @default(now()) @map("timestamp")

  exercise PronunciationExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pronunciation_attempts")
}

model Tag {
  id   BigInt @id @default(autoincrement())
  name String @unique

  grammarLinks GrammarLessonTag[]
  storyLinks   StoryTag[]

  @@map("tags")
}

model GrammarLessonTag {
  grammarId String @map("grammar_id")
  tagId     BigInt @map("tag_id")

  grammar GrammarLesson @relation(fields: [grammarId], references: [id], onDelete: Cascade)
  tag     Tag           @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([grammarId, tagId])
  @@map("grammar_lesson_tags")
}

model StoryTag {
  storyId String @map("story_id")
  tagId   BigInt @map("tag_id")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([storyId, tagId])
  @@map("story_tags")
}

model Classroom {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  teacherId String   @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")

  teacher                  User                     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students                 ClassroomStudent[]
  grammarAssignments       ClassroomGrammar[]
  storyAssignments         ClassroomStory[]
  vocabListAssignments     ClassroomVocabList[]
  pronunciationAssignments ClassroomPronunciation[]
  quizAssignments          ClassroomQuiz[]

  @@map("classrooms")
}

model ClassroomStudent {
  classroomId String   @map("classroom_id")
  studentId   String   @map("student_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classroomId, studentId])
  @@map("classroom_students")
}

model ClassroomGrammar {
  classroomId String   @map("classroom_id")
  grammarId   String   @map("grammar_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  classroom Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  grammar   GrammarLesson @relation(fields: [grammarId], references: [id], onDelete: Cascade)

  @@id([classroomId, grammarId])
  @@index([grammarId])
  @@map("classroom_grammar")
}

model ClassroomStory {
  classroomId String   @map("classroom_id")
  storyId     String   @map("story_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([classroomId, storyId])
  @@index([storyId])
  @@map("classroom_story")
}

model ClassroomVocabList {
  classroomId String   @map("classroom_id")
  vocabListId String   @map("vocab_list_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  vocabList VocabList @relation(fields: [vocabListId], references: [id], onDelete: Cascade)

  @@id([classroomId, vocabListId])
  @@index([vocabListId])
  @@map("classroom_vocab_list")
}

model ClassroomPronunciation {
  classroomId String   @map("classroom_id")
  exerciseId  String   @map("exercise_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  classroom Classroom             @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  exercise  PronunciationExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([classroomId, exerciseId])
  @@index([exerciseId])
  @@map("classroom_pronunciation")
}

model ClassroomQuiz {
  classroomId String   @map("classroom_id")
  quizId      String   @map("quiz_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([classroomId, quizId])
  @@index([quizId])
  @@map("classroom_quiz")
}
