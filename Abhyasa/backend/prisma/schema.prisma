// This creates the Prisma Client used in the backend code.
generator client {
  provider = "prisma-client-js"
}

// This connects Prisma to the PostgreSQL database.
datasource db {
  provider = "postgresql"
}

// Roles available for users in the system.
enum UserRole {
  admin
  teacher
  student

  @@map("user_role")
}

// Difficulty levels for learning content.
enum ContentLevel {
  beginner
  intermediate
  advanced

  @@map("content_level")
}

// Types of content available in the app.
enum ContentType {
  grammar
  story
  vocab
  pronunciation
  quiz

  @@map("content_type")
}

// Possible results for pronunciation checking.
enum PronunciationScore {
  exact
  close
  mismatch

  @@map("pronunciation_score")
}

// Types of pronunciation targets.
enum PronunciationTargetType {
  word
  phrase
  sentence

  @@map("pronunciation_target_type")
}

// Stores all users such as admins, teachers, and students.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")

  // Content created by a teacher.
  grammarLessons         GrammarLesson[]
  stories                Story[]
  vocabLists             VocabList[]
  vocabItems             VocabItem[]
  pronunciationExercises PronunciationExercise[]
  quizzes                Quiz[]

  // Student activity records.
  quizAttempts           QuizAttempt[]
  progressCompletions    ProgressCompletion[]
  pronunciationAttempts  PronunciationAttempt[]

  // Classroom relations for teachers and students.
  taughtClassrooms       Classroom[]
  joinedClassrooms       ClassroomStudent[]

  @@map("users")
}

// Stores grammar lessons created by teachers.
model GrammarLesson {
  id        String       @id @default(uuid())
  title     String
  content   String
  level     ContentLevel
  teacherId String       @map("teacher_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // The teacher who created this grammar lesson.
  teacher              User               @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  // Links to stories, tags, and classroom assignments.
  storyRefs            StoryGrammarRef[]
  tags                 GrammarLessonTag[]
  classroomAssignments ClassroomGrammar[]

  @@index([level])
  @@map("grammar_lessons")
}

// Stores story content created by teachers.
model Story {
  id        String       @id @default(uuid())
  title     String
  content   String
  summary   String
  level     ContentLevel
  teacherId String       @map("teacher_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // The teacher who created this story.
  teacher              User                     @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  // Links to grammar, vocabulary, tags, pronunciation, and classrooms.
  grammarRefs          StoryGrammarRef[]
  vocabRefs            StoryVocabRef[]
  tags                 StoryTag[]
  pronunciationLinks   PronunciationStoryLink[]
  classroomAssignments ClassroomStory[]

  @@index([level])
  @@map("stories")
}

// Connects stories with grammar lessons.
model StoryGrammarRef {
  storyId   String @map("story_id")
  grammarId String @map("grammar_id")

  // Linked story and grammar lesson.
  story   Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  grammar GrammarLesson @relation(fields: [grammarId], references: [id], onDelete: Restrict)

  @@id([storyId, grammarId])
  @@map("story_grammar_refs")
}

// Stores vocabulary lists created by teachers.
model VocabList {
  id          String       @id @default(uuid())
  name        String
  description String
  level       ContentLevel
  teacherId   String       @map("teacher_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // The teacher who created this vocabulary list.
  teacher              User                 @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  // Vocabulary items and classroom assignments for this list.
  items                VocabItem[]
  classroomAssignments ClassroomVocabList[]

  @@index([level])
  @@map("vocab_lists")
}

// Stores single vocabulary words inside a vocabulary list.
model VocabItem {
  id         String       @id @default(uuid())
  word       String
  definition String
  example    String
  phonetic   String
  listId     String       @map("list_id")
  level      ContentLevel
  teacherId  String       @map("teacher_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  // The list and teacher connected to this vocabulary item.
  list               VocabList                @relation(fields: [listId], references: [id], onDelete: Cascade)
  teacher            User                     @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  // Links to stories and pronunciation exercises.
  storyRefs          StoryVocabRef[]
  pronunciationLinks PronunciationVocabLink[]

  @@index([listId])
  @@map("vocab_items")
}

// Connects stories with vocabulary items.
model StoryVocabRef {
  storyId       String @map("story_id")
  vocabItemId   String @map("vocab_item_id")
  highlightText String @map("highlight_text")

  // Linked story and vocabulary item.
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  vocabItem VocabItem @relation(fields: [vocabItemId], references: [id], onDelete: Restrict)

  @@id([storyId, vocabItemId, highlightText])
  @@map("story_vocab_refs")
}

// Stores pronunciation exercises created by teachers.
model PronunciationExercise {
  id           String                  @id @default(uuid())
  targetText   String                  @map("target_text")
  type         PronunciationTargetType
  level        ContentLevel
  instructions String
  teacherId    String                  @map("teacher_id")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  // The teacher who created this pronunciation exercise.
  teacher              User                     @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  // Links to vocabulary, stories, attempts, and classrooms.
  vocabLinks           PronunciationVocabLink[]
  storyLinks           PronunciationStoryLink[]
  attempts             PronunciationAttempt[]
  classroomAssignments ClassroomPronunciation[]

  @@map("pronunciation_exercises")
}

// Connects pronunciation exercises with vocabulary items.
model PronunciationVocabLink {
  exerciseId  String @map("exercise_id")
  vocabItemId String @map("vocab_item_id")

  // Linked pronunciation exercise and vocabulary item.
  exercise  PronunciationExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  vocabItem VocabItem             @relation(fields: [vocabItemId], references: [id], onDelete: Restrict)

  @@id([exerciseId, vocabItemId])
  @@map("pronunciation_vocab_links")
}

// Connects pronunciation exercises with stories.
model PronunciationStoryLink {
  exerciseId String @map("exercise_id")
  storyId    String @map("story_id")

  // Linked pronunciation exercise and story.
  exercise PronunciationExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  story    Story                 @relation(fields: [storyId], references: [id], onDelete: Restrict)

  @@id([exerciseId, storyId])
  @@map("pronunciation_story_links")
}

// Stores quizzes created by teachers.
model Quiz {
  id          String       @id @default(uuid())
  title       String
  description String
  level       ContentLevel
  teacherId   String       @map("teacher_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // The teacher who created this quiz.
  teacher              User              @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  // Questions, attempts, linked content, and classroom assignments.
  questions            QuizQuestion[]
  attempts             QuizAttempt[]
  contentLinks         QuizContentLink[]
  classroomAssignments ClassroomQuiz[]

  @@map("quizzes")
}

// Connects quizzes with other content like grammar, story, vocab, or pronunciation.
model QuizContentLink {
  quizId     String      @map("quiz_id")
  linkedType ContentType @map("linked_type")
  linkedId   String      @map("linked_id")

  // The quiz connected to this content link.
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([quizId, linkedType, linkedId])
  @@map("quiz_content_links")
}

// Stores questions for a quiz.
model QuizQuestion {
  id              String  @id @default(uuid())
  quizId          String  @map("quiz_id")
  text            String
  explanation     String
  correctOptionId String? @map("correct_option_id")

  // The quiz this question belongs to.
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  // Options and answers connected to this question.
  options QuizOption[]
  answers QuizAnswer[]

  @@map("quiz_questions")
}

// Stores answer options for quiz questions.
model QuizOption {
  id         String @id @default(uuid())
  questionId String @map("question_id")
  text       String

  // The question this option belongs to.
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Answers where this option was selected.
  selectedIn QuizAnswer[] @relation("SelectedOption")

  @@map("quiz_options")
}

// Stores a user's quiz attempt.
model QuizAttempt {
  id               String   @id @default(uuid())
  quizId           String   @map("quiz_id")
  userId           String   @map("user_id")
  userNameSnapshot String   @map("user_name_snapshot")
  score            Int
  totalQuestions   Int      @map("total_questions")
  completedAt      DateTime @default(now()) @map("completed_at")

  // The quiz and user connected to this attempt.
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Answers submitted in this attempt.
  answers QuizAnswer[]

  @@index([userId])
  @@map("quiz_attempts")
}

// Stores each answer given during a quiz attempt.
model QuizAnswer {
  attemptId        String  @map("attempt_id")
  questionId       String  @map("question_id")
  selectedOptionId String  @map("selected_option_id")
  isCorrect        Boolean @map("is_correct")

  // The attempt, question, and selected option for this answer.
  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selected QuizOption   @relation("SelectedOption", fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@map("quiz_answers")
}

// Stores completed content for each user.
model ProgressCompletion {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  contentType ContentType @map("content_type")
  contentId   String      @map("content_id")
  completedAt DateTime    @default(now()) @map("completed_at")

  // The user who completed the content.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId], name: "userId_contentType_contentId")
  @@index([userId])
  @@map("progress_completions")
}

// Stores a user's pronunciation attempt.
model PronunciationAttempt {
  id           String             @id @default(uuid())
  exerciseId   String             @map("exercise_id")
  userId       String             @map("user_id")
  expected     String
  transcript   String
  score        PronunciationScore
  matchPercent Decimal            @map("match_percent") @db.Decimal(5, 2)
  feedback     String
  timestamp    DateTime           @default(now()) @map("timestamp")

  // The pronunciation exercise and user connected to this attempt.
  exercise PronunciationExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pronunciation_attempts")
}

// Stores tags used for grammar lessons and stories.
model Tag {
  id   BigInt @id @default(autoincrement())
  name String @unique

  // Links to grammar lessons and stories.
  grammarLinks GrammarLessonTag[]
  storyLinks   StoryTag[]

  @@map("tags")
}

// Connects grammar lessons with tags.
model GrammarLessonTag {
  grammarId String @map("grammar_id")
  tagId     BigInt @map("tag_id")

  // Linked grammar lesson and tag.
  grammar GrammarLesson @relation(fields: [grammarId], references: [id], onDelete: Cascade)
  tag     Tag           @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([grammarId, tagId])
  @@map("grammar_lesson_tags")
}

// Connects stories with tags.
model StoryTag {
  storyId String @map("story_id")
  tagId   BigInt @map("tag_id")

  // Linked story and tag.
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([storyId, tagId])
  @@map("story_tags")
}

// Stores classrooms created by teachers.
model Classroom {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  teacherId String   @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")

  // The teacher who owns this classroom.
  teacher                  User                     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // Students and assigned learning content.
  students                 ClassroomStudent[]
  grammarAssignments       ClassroomGrammar[]
  storyAssignments         ClassroomStory[]
  vocabListAssignments     ClassroomVocabList[]
  pronunciationAssignments ClassroomPronunciation[]
  quizAssignments          ClassroomQuiz[]

  @@map("classrooms")
}

// Connects students with classrooms they joined.
model ClassroomStudent {
  classroomId String   @map("classroom_id")
  studentId   String   @map("student_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  // Linked classroom and student.
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classroomId, studentId])
  @@map("classroom_students")
}

// Assigns grammar lessons to classrooms.
model ClassroomGrammar {
  classroomId String   @map("classroom_id")
  grammarId   String   @map("grammar_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  // Linked classroom and grammar lesson.
  classroom Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  grammar   GrammarLesson @relation(fields: [grammarId], references: [id], onDelete: Cascade)

  @@id([classroomId, grammarId])
  @@index([grammarId])
  @@map("classroom_grammar")
}

// Assigns stories to classrooms.
model ClassroomStory {
  classroomId String   @map("classroom_id")
  storyId     String   @map("story_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  // Linked classroom and story.
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([classroomId, storyId])
  @@index([storyId])
  @@map("classroom_story")
}

// Assigns vocabulary lists to classrooms.
model ClassroomVocabList {
  classroomId String   @map("classroom_id")
  vocabListId String   @map("vocab_list_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  // Linked classroom and vocabulary list.
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  vocabList VocabList @relation(fields: [vocabListId], references: [id], onDelete: Cascade)

  @@id([classroomId, vocabListId])
  @@index([vocabListId])
  @@map("classroom_vocab_list")
}

// Assigns pronunciation exercises to classrooms.
model ClassroomPronunciation {
  classroomId String   @map("classroom_id")
  exerciseId  String   @map("exercise_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  // Linked classroom and pronunciation exercise.
  classroom Classroom             @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  exercise  PronunciationExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([classroomId, exerciseId])
  @@index([exerciseId])
  @@map("classroom_pronunciation")
}

// Assigns quizzes to classrooms.
model ClassroomQuiz {
  classroomId String   @map("classroom_id")
  quizId      String   @map("quiz_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  // Linked classroom and quiz.
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([classroomId, quizId])
  @@index([quizId])
  @@map("classroom_quiz")
}